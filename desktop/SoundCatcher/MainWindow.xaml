<Window x:Class="SoundCatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundCatcher.Controls"
        Title="Sound Catcher"
        Width="540"
        Height="772"
        MinWidth="500"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C10"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        Icon="app.ico"
        TextOptions.TextFormattingMode="Display">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource AccentGradient}">
                    <Ellipse Width="8" Height="8" Fill="#0B0C10" />
                </Border>
                <TextBlock Text="Sound Catcher"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border x:Name="StatusPill"
                    Grid.Column="1"
                    CornerRadius="20"
                    Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    Padding="10,3"
                    VerticalAlignment="Center">
                <TextBlock x:Name="StatusPillText"
                           Text="Siap"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" />
            </Border>
        </Grid>

        <!-- Now playing -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="52" Height="52">
                    <Border CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5A5FA8" Offset="0" />
                                <GradientStop Color="#A0558C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="ArtworkPlaceholder"
                               Text="♪"
                               FontSize="22"
                               Foreground="#E7E9EE"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Rectangle x:Name="ArtworkRect" RadiusX="10" RadiusY="10" Visibility="Collapsed" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TrackTitle"
                               Text="Tidak ada lagu terdeteksi"
                               FontWeight="SemiBold"
                               FontSize="13.5"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TrackArtist"
                               Text="Putar audio di aplikasi apa pun"
                               Style="{StaticResource Caption}"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Timer + meter -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,18">
            <StackPanel>
                <TextBlock x:Name="TimerText"
                           Text="00:00"
                           FontSize="44"
                           FontWeight="Light"
                           FontFamily="Segoe UI Light"
                           HorizontalAlignment="Center" />
                <controls:LevelMeter x:Name="Meter" Height="42" Margin="0,12,0,10" />
                <TextBlock x:Name="DetailText"
                           Text="Tekan Mulai Rekam untuk merekam audio output."
                           Style="{StaticResource Caption}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Settings -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sumber audio" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <Button x:Name="DeviceButton"
                            Grid.Column="1"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right"
                            MaxWidth="300"
                            Click="DeviceButton_Click">
                        <TextBlock x:Name="DeviceText" Text="Default" TextTrimming="CharacterEllipsis" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Format" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton x:Name="Mp3Radio" Content="MP3" Tag="mp3"
                                     GroupName="Format" Style="{StaticResource SegButton}"
                                     Checked="Format_Checked" />
                        <RadioButton x:Name="WavRadio" Content="WAV" Tag="wav"
                                     GroupName="Format" Style="{StaticResource SegButton}"
                                     Checked="Format_Checked" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="BitrateRow" Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bitrate MP3" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton x:Name="Bitrate128" Content="128" Tag="128"
                                     GroupName="Bitrate" Style="{StaticResource SegButton}"
                                     Checked="Bitrate_Checked" />
                        <RadioButton x:Name="Bitrate192" Content="192" Tag="192"
                                     GroupName="Bitrate" Style="{StaticResource SegButton}"
                                     Checked="Bitrate_Checked" />
                        <RadioButton x:Name="Bitrate256" Content="256" Tag="256"
                                     GroupName="Bitrate" Style="{StaticResource SegButton}"
                                     Checked="Bitrate_Checked" />
                        <RadioButton x:Name="Bitrate320" Content="320" Tag="320"
                                     GroupName="Bitrate" Style="{StaticResource SegButton}"
                                     Checked="Bitrate_Checked" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Simpan ke" Style="{StaticResource Caption}" />
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Style="{StaticResource PathBox}" />
                        <Button Grid.Column="1" Content="Ubah"
                                Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0"
                                Click="ChangeFolder_Click" />
                    </Grid>
                </Grid>

                <CheckBox x:Name="OpenFolderCheck"
                          Grid.Row="4"
                          Content="Buka folder setelah selesai"
                          Style="{StaticResource Check}"
                          Margin="0,12,0,0"
                          Checked="OpenFolder_Changed"
                          Unchecked="OpenFolder_Changed" />

                <CheckBox x:Name="AutoTrimCheck"
                          Grid.Row="5"
                          Content="Rapikan otomatis (buang senyap di awal dan akhir)"
                          Style="{StaticResource Check}"
                          Margin="0,8,0,0"
                          Checked="AutoTrim_Changed"
                          Unchecked="AutoTrim_Changed" />
            </Grid>
        </Border>

        <Button x:Name="RecordButton"
                Grid.Row="4"
                Content="Mulai Rekam"
                Style="{StaticResource PrimaryButton}"
                Height="58"
                Margin="0,14,0,0"
                Click="RecordButton_Click" />

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Text="Siap. Audio direkam langsung dari perangkat output."
                       Style="{StaticResource Caption}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />

            <Button x:Name="CropButton"
                    Grid.Column="1"
                    Content="Potong..."
                    Style="{StaticResource GhostButton}"
                    Margin="10,0,0,0"
                    Visibility="Collapsed"
                    Click="Crop_Click" />
        </Grid>
        </Grid>
    </ScrollViewer>
</Window>
