<Window x:Class="SoundCatcher.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundCatcher.Controls"
        Title="Potong rekaman"
        Width="780"
        Height="480"
        MinWidth="640"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="#0B0C10"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Potong rekaman" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="FileNameText" Style="{StaticResource Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <controls:WaveformView x:Name="Wave" Grid.Row="1" Height="190" Margin="0,14,0,0" />

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StartText" Grid.Column="0" Style="{StaticResource Caption}" />
            <TextBlock x:Name="EndText" Grid.Column="1" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
            <TextBlock x:Name="LengthText" Grid.Column="2" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="PreviewButton" Content="Putar pilihan" Style="{StaticResource GhostButton}" Click="Preview_Click" />
            <Button Content="Rapikan otomatis" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="AutoTrim_Click" />
            <Button Content="Pilih semua" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="SelectAll_Click" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <ProgressBar x:Name="ExportBar" Height="4" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"
                         Background="{StaticResource PanelAltBrush}" Foreground="{StaticResource AccentBrush}" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="6" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SaveButton" Content="Simpan potongan" Style="{StaticResource PrimaryButton}" Width="200" Click="Save_Click" />
            <Button Grid.Column="2" Content="Batal" Style="{StaticResource GhostButton}" Width="90" Click="Cancel_Click" />
        </Grid>
    </Grid>
</Window>
